// Migrated from legacy DPC-2 free-function API to CACHE::llc_* member function interface.
// Inlines OPTgen and HAWKEYE_PC_PREDICTOR (previously in optgen.h / hawkeye_predictor.h)
// so the file is self-contained after the build system copies it to llc_replacement.cc.

#include "cache.h"
#include <vector>
#include <map>
#include <cmath>

using namespace std;

// ---------------------------------------------------------------------------
// Compile-time log2 (same pattern as mockingjay.llc_repl)
// ---------------------------------------------------------------------------
constexpr int hk_log2(int n) { return (n <= 1) ? 0 : 1 + hk_log2(n / 2); }

// ---------------------------------------------------------------------------
// Hawkeye configuration
// ---------------------------------------------------------------------------
#define HK_maxRRPV          7          // 3-bit RRPV counters (0-7)
#define HK_MAX_SHCT         31         // 5-bit saturating counter
#define HK_SHCT_SIZE_BITS   11
#define HK_SHCT_SIZE        (1 << HK_SHCT_SIZE_BITS)   // 2048 entries
#define HK_OPTGEN_VECTOR_SIZE 128
#define HK_TIMER_SIZE       1024
#define HK_SAMPLED_CACHE_SIZE 2800
#define HK_SAMPLER_WAYS     8
#define HK_SAMPLER_SETS     (HK_SAMPLED_CACHE_SIZE / HK_SAMPLER_WAYS)  // 350

// ---------------------------------------------------------------------------
// CRC hash (for PC signature and sampler tag)
// ---------------------------------------------------------------------------
static uint64_t HK_CRC(uint64_t _blockAddress)
{
    static const unsigned long long crcPolynomial = 3988292384ULL;
    unsigned long long _returnVal = _blockAddress;
    for (unsigned int i = 0; i < 32; i++)
        _returnVal = ((_returnVal & 1) == 1) ? ((_returnVal >> 1) ^ crcPolynomial) : (_returnVal >> 1);
    return _returnVal;
}

// ---------------------------------------------------------------------------
// HAWKEYE_PC_PREDICTOR — Signature History Counter Table (SHCT)
//   2048 entries, 5-bit saturating counter (0-31), threshold at 16
// ---------------------------------------------------------------------------
class HAWKEYE_PC_PREDICTOR
{
    map<uint64_t, short unsigned int> SHCT;

public:
    void increment(uint64_t pc)
    {
        uint64_t signature = HK_CRC(pc) % HK_SHCT_SIZE;
        if (SHCT.find(signature) == SHCT.end())
            SHCT[signature] = (1 + HK_MAX_SHCT) / 2;
        SHCT[signature] = (SHCT[signature] < HK_MAX_SHCT) ? (SHCT[signature] + 1) : HK_MAX_SHCT;
    }

    void decrement(uint64_t pc)
    {
        uint64_t signature = HK_CRC(pc) % HK_SHCT_SIZE;
        if (SHCT.find(signature) == SHCT.end())
            SHCT[signature] = (1 + HK_MAX_SHCT) / 2;
        if (SHCT[signature] != 0)
            SHCT[signature] = SHCT[signature] - 1;
    }

    bool get_prediction(uint64_t pc)
    {
        uint64_t signature = HK_CRC(pc) % HK_SHCT_SIZE;
        if (SHCT.find(signature) != SHCT.end() && SHCT[signature] < ((HK_MAX_SHCT + 1) / 2))
            return false;
        return true;
    }
};

// ---------------------------------------------------------------------------
// ADDR_INFO — per-line metadata for the sampler
// ---------------------------------------------------------------------------
struct HK_ADDR_INFO
{
    uint64_t addr;
    uint32_t last_quanta;
    uint64_t PC;
    bool     prefetched;
    uint32_t lru;

    void init(unsigned int /*curr_quanta*/)
    {
        last_quanta = 0;
        PC          = 0;
        prefetched  = false;
        lru         = 0;
    }

    void update(unsigned int curr_quanta, uint64_t _pc, bool /*prediction*/)
    {
        last_quanta = curr_quanta;
        PC          = _pc;
    }

    void mark_prefetch()
    {
        prefetched = true;
    }
};

// ---------------------------------------------------------------------------
// OPTgen — per-set optimal cache occupancy simulator
// ---------------------------------------------------------------------------
struct HK_OPTgen
{
    vector<unsigned int> liveness_history;
    uint64_t num_cache;
    uint64_t num_dont_cache;
    uint64_t access;
    uint64_t CACHE_SIZE;

    void init(uint64_t size)
    {
        num_cache      = 0;
        num_dont_cache = 0;
        access         = 0;
        CACHE_SIZE     = size;
        liveness_history.resize(HK_OPTGEN_VECTOR_SIZE, 0);
    }

    void add_access(uint64_t curr_quanta)
    {
        access++;
        liveness_history[curr_quanta] = 0;
    }

    void add_prefetch(uint64_t curr_quanta)
    {
        liveness_history[curr_quanta] = 0;
    }

    bool should_cache(uint64_t curr_quanta, uint64_t last_quanta)
    {
        bool is_cache = true;

        unsigned int i = last_quanta;
        while (i != curr_quanta) {
            if (liveness_history[i] >= CACHE_SIZE) {
                is_cache = false;
                break;
            }
            i = (i + 1) % liveness_history.size();
        }

        if (is_cache) {
            i = last_quanta;
            while (i != curr_quanta) {
                liveness_history[i]++;
                i = (i + 1) % liveness_history.size();
            }
            assert(i == curr_quanta);
        }

        if (is_cache) num_cache++;
        else          num_dont_cache++;

        return is_cache;
    }

    uint64_t get_num_opt_hits()
    {
        return num_cache;
    }
};

// ---------------------------------------------------------------------------
// Global state
// ---------------------------------------------------------------------------

// RRPV counters for all LLC lines
uint32_t hk_rrpv[LLC_SET][LLC_WAY];

// Per-set timers (only used by sampled sets)
uint64_t hk_perset_mytimer[LLC_SET];

// Per-set OPTgen occupancy vectors (only used by sampled sets)
HK_OPTgen hk_perset_optgen[LLC_SET];

// Signatures and prefetch flags for sampled sets
uint64_t hk_signatures[LLC_SET][LLC_WAY];
bool     hk_prefetched[LLC_SET][LLC_WAY];

// Hawkeye predictors — one for demand, one for prefetch
HAWKEYE_PC_PREDICTOR* hk_demand_predictor;
HAWKEYE_PC_PREDICTOR* hk_prefetch_predictor;

// Sampler — address history indexed by sampler set
vector<map<uint64_t, HK_ADDR_INFO>> hk_addr_history;

// ---------------------------------------------------------------------------
// Sampler helpers
// ---------------------------------------------------------------------------
static void hk_replace_addr_history_element(unsigned int sampler_set)
{
    uint64_t lru_addr = 0;
    for (map<uint64_t, HK_ADDR_INFO>::iterator it = hk_addr_history[sampler_set].begin();
         it != hk_addr_history[sampler_set].end(); ++it) {
        if ((it->second).lru == (HK_SAMPLER_WAYS - 1)) {
            lru_addr = it->first;
            break;
        }
    }
    hk_addr_history[sampler_set].erase(lru_addr);
}

static void hk_update_addr_history_lru(unsigned int sampler_set, unsigned int curr_lru)
{
    for (map<uint64_t, HK_ADDR_INFO>::iterator it = hk_addr_history[sampler_set].begin();
         it != hk_addr_history[sampler_set].end(); ++it) {
        if ((it->second).lru < curr_lru) {
            (it->second).lru++;
            assert((it->second).lru < HK_SAMPLER_WAYS);
        }
    }
}

// ---------------------------------------------------------------------------
// Is this LLC set a sampled set?
// Original: bits(set, 0, 6) == bits(set, log2(LLC_SETS)-6, 6)
// Adaptive: works for any NUM_CPUS by using LLC_SET at compile time.
// ---------------------------------------------------------------------------
static bool HK_SAMPLED_SET(uint32_t set)
{
    constexpr int upper_shift = hk_log2(LLC_SET) - 6;
    return ((set & 0x3F) == ((set >> upper_shift) & 0x3F));
}

// ===========================================================================
// CACHE::llc_initialize_replacement
// ===========================================================================
void CACHE::llc_initialize_replacement()
{
    for (int i = 0; i < LLC_SET; i++) {
        for (int j = 0; j < LLC_WAY; j++) {
            hk_rrpv[i][j]       = HK_maxRRPV;
            hk_signatures[i][j]  = 0;
            hk_prefetched[i][j]  = false;
        }
        hk_perset_mytimer[i] = 0;
        hk_perset_optgen[i].init(LLC_WAY - 2);
    }

    hk_addr_history.resize(HK_SAMPLER_SETS);
    for (int i = 0; i < HK_SAMPLER_SETS; i++)
        hk_addr_history[i].clear();

    hk_demand_predictor   = new HAWKEYE_PC_PREDICTOR();
    hk_prefetch_predictor = new HAWKEYE_PC_PREDICTOR();

    cout << "Initialize Hawkeye state" << endl;
}

// ===========================================================================
// CACHE::llc_find_victim
// ===========================================================================
uint32_t CACHE::llc_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set,
                                const BLOCK *current_set, uint64_t ip,
                                uint64_t full_addr, uint32_t type)
{
    // If there is an invalid block, use it first
    for (uint32_t way = 0; way < (uint32_t)LLC_WAY; way++) {
        if (current_set[way].valid == false)
            return way;
    }

    // Look for a line with maxRRPV (cache-averse)
    for (uint32_t i = 0; i < (uint32_t)LLC_WAY; i++)
        if (hk_rrpv[set][i] == HK_maxRRPV)
            return i;

    // No cache-averse line found — evict the oldest cache-friendly line
    uint32_t max_rrip  = 0;
    int32_t  lru_victim = -1;
    for (uint32_t i = 0; i < (uint32_t)LLC_WAY; i++) {
        if (hk_rrpv[set][i] >= max_rrip) {
            max_rrip  = hk_rrpv[set][i];
            lru_victim = i;
        }
    }

    assert(lru_victim != -1);

    // Negative training on LRU evictions from sampled sets
    if (HK_SAMPLED_SET(set)) {
        if (hk_prefetched[set][lru_victim])
            hk_prefetch_predictor->decrement(hk_signatures[set][lru_victim]);
        else
            hk_demand_predictor->decrement(hk_signatures[set][lru_victim]);
    }

    return lru_victim;
}

// ===========================================================================
// CACHE::llc_update_replacement_state
//   Called on every cache hit and cache fill.
// ===========================================================================
void CACHE::llc_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way,
                                         uint64_t full_addr, uint64_t ip,
                                         uint64_t victim_addr, uint32_t type,
                                         uint8_t hit)
{
    full_addr = (full_addr >> 6) << 6;   // align to cache-line boundary

    // Track prefetch status per LLC line
    if (type == PREFETCH) {
        if (!hit)
            hk_prefetched[set][way] = true;
    } else {
        hk_prefetched[set][way] = false;
    }

    // Ignore writebacks for training / RRPV updates
    if (type == WRITEBACK)
        return;

    // ------------------------------------------------------------------
    // OPTgen sampler training (only for sampled sets)
    // ------------------------------------------------------------------
    if (HK_SAMPLED_SET(set)) {
        uint64_t curr_quanta = hk_perset_mytimer[set] % HK_OPTGEN_VECTOR_SIZE;

        uint32_t sampler_set = (full_addr >> 6) % HK_SAMPLER_SETS;
        uint64_t sampler_tag = HK_CRC(full_addr >> 12) % 256;
        assert(sampler_set < (uint32_t)HK_SAMPLER_SETS);

        // --- Re-reference of a known line (demand only) ---
        if ((hk_addr_history[sampler_set].find(sampler_tag) != hk_addr_history[sampler_set].end())
            && (type != PREFETCH))
        {
            unsigned int curr_timer = hk_perset_mytimer[set];
            if (curr_timer < hk_addr_history[sampler_set][sampler_tag].last_quanta)
                curr_timer = curr_timer + HK_TIMER_SIZE;
            bool wrap = ((curr_timer - hk_addr_history[sampler_set][sampler_tag].last_quanta)
                         > HK_OPTGEN_VECTOR_SIZE);
            uint64_t last_quanta =
                hk_addr_history[sampler_set][sampler_tag].last_quanta % HK_OPTGEN_VECTOR_SIZE;

            if (!wrap && hk_perset_optgen[set].should_cache(curr_quanta, last_quanta)) {
                if (hk_addr_history[sampler_set][sampler_tag].prefetched)
                    hk_prefetch_predictor->increment(hk_addr_history[sampler_set][sampler_tag].PC);
                else
                    hk_demand_predictor->increment(hk_addr_history[sampler_set][sampler_tag].PC);
            } else {
                if (hk_addr_history[sampler_set][sampler_tag].prefetched)
                    hk_prefetch_predictor->decrement(hk_addr_history[sampler_set][sampler_tag].PC);
                else
                    hk_demand_predictor->decrement(hk_addr_history[sampler_set][sampler_tag].PC);
            }

            hk_perset_optgen[set].add_access(curr_quanta);
            hk_update_addr_history_lru(sampler_set,
                                       hk_addr_history[sampler_set][sampler_tag].lru);

            // Demand re-reference clears the prefetch flag
            hk_addr_history[sampler_set][sampler_tag].prefetched = false;
        }
        // --- First time seeing this line (demand or prefetch) ---
        else if (hk_addr_history[sampler_set].find(sampler_tag) == hk_addr_history[sampler_set].end())
        {
            if ((int)hk_addr_history[sampler_set].size() == HK_SAMPLER_WAYS)
                hk_replace_addr_history_element(sampler_set);

            assert((int)hk_addr_history[sampler_set].size() < HK_SAMPLER_WAYS);

            hk_addr_history[sampler_set][sampler_tag].init(curr_quanta);

            if (type == PREFETCH) {
                hk_addr_history[sampler_set][sampler_tag].mark_prefetch();
                hk_perset_optgen[set].add_prefetch(curr_quanta);
            } else {
                hk_perset_optgen[set].add_access(curr_quanta);
            }
            hk_update_addr_history_lru(sampler_set, HK_SAMPLER_WAYS - 1);
        }
        // --- Prefetch re-reference of a known line ---
        else
        {
            assert(hk_addr_history[sampler_set].find(sampler_tag) !=
                   hk_addr_history[sampler_set].end());

            uint64_t last_quanta =
                hk_addr_history[sampler_set][sampler_tag].last_quanta % HK_OPTGEN_VECTOR_SIZE;

            if (hk_perset_mytimer[set] - hk_addr_history[sampler_set][sampler_tag].last_quanta
                < 5 * NUM_CPUS)
            {
                if (hk_perset_optgen[set].should_cache(curr_quanta, last_quanta)) {
                    if (hk_addr_history[sampler_set][sampler_tag].prefetched)
                        hk_prefetch_predictor->increment(hk_addr_history[sampler_set][sampler_tag].PC);
                    else
                        hk_demand_predictor->increment(hk_addr_history[sampler_set][sampler_tag].PC);
                }
            }

            hk_addr_history[sampler_set][sampler_tag].mark_prefetch();
            hk_perset_optgen[set].add_prefetch(curr_quanta);
            hk_update_addr_history_lru(sampler_set,
                                       hk_addr_history[sampler_set][sampler_tag].lru);
        }

        // Record prediction, PC, and timestamp into the sampler entry
        bool new_prediction = hk_demand_predictor->get_prediction(ip);
        if (type == PREFETCH)
            new_prediction = hk_prefetch_predictor->get_prediction(ip);

        hk_addr_history[sampler_set][sampler_tag].update(hk_perset_mytimer[set],
                                                         ip, new_prediction);
        hk_addr_history[sampler_set][sampler_tag].lru = 0;

        // Advance per-set timer
        hk_perset_mytimer[set] = (hk_perset_mytimer[set] + 1) % HK_TIMER_SIZE;
    }

    // ------------------------------------------------------------------
    // RRPV update for the actual LLC line
    // ------------------------------------------------------------------
    bool new_prediction = hk_demand_predictor->get_prediction(ip);
    if (type == PREFETCH)
        new_prediction = hk_prefetch_predictor->get_prediction(ip);

    hk_signatures[set][way] = ip;

    if (!new_prediction) {
        // Predictor says cache-averse → mark for quick eviction
        hk_rrpv[set][way] = HK_maxRRPV;
    } else {
        // Predictor says cache-friendly → promote to MRU
        hk_rrpv[set][way] = 0;
        if (!hit) {
            // Age all other cache-friendly lines (unless saturated)
            bool saturated = false;
            for (uint32_t i = 0; i < (uint32_t)LLC_WAY; i++)
                if (hk_rrpv[set][i] == HK_maxRRPV - 1)
                    saturated = true;

            for (uint32_t i = 0; i < (uint32_t)LLC_WAY; i++) {
                if (!saturated && hk_rrpv[set][i] < HK_maxRRPV - 1)
                    hk_rrpv[set][i]++;
            }
        }
        hk_rrpv[set][way] = 0;
    }
}

// ===========================================================================
// CACHE::llc_replacement_final_stats
// ===========================================================================
void CACHE::llc_replacement_final_stats()
{
    unsigned int hits    = 0;
    unsigned int accesses = 0;
    for (int i = 0; i < LLC_SET; i++) {
        accesses += hk_perset_optgen[i].access;
        hits     += hk_perset_optgen[i].get_num_opt_hits();
    }

    cout << "OPTgen accesses: " << accesses << endl;
    cout << "OPTgen hits: "     << hits     << endl;
    if (accesses > 0)
        cout << "OPTgen hit rate: " << 100.0 * (double)hits / (double)accesses << endl;
    cout << endl;
}
