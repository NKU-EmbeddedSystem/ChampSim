# --- Prefetch policies to evaluate (paper: 11/12 available) ---
# Format: "policy_name:degree1,degree2,..."
#
# Built with our ChampSim (ported via pythia_adapter):
#   no, next_line, stride, stream
# Built with Pythia ChampSim (in bin/pythia/):
#   ampm, sms, bingo, sandbox, power7, dspatch, mlop, ppf
# Not yet available:
#   pythia (scooby) — linker error from RL engine
#
# Paper: Bhardwaj et al., "Pythia: A Custom Hardware Prefetching Framework"
export PREFETCH_POLICIES=(
  "no:1"
  "next_line:1"
  "stride:1,2,3,4,5,6,7,8"
  "stream:1,2,3,4,5,6,7,8"
  "ampm:1,4,8,12,16"
  "sms:1,4,8,12,16,20,24,28,31"
  "bingo:1"
  "sandbox:1,2,3,4,5,6,7,8"
  "power7:0,1,2,3,4,5,6"
  "dspatch:0,8,16,24,32,40,48,56,64"
  "mlop:1,4,8,12,16"
  "ppf:1"
)
